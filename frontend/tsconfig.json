{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler",
		// #130: `#lib` lo resuelven Vite y Node por el campo `imports` de
		// package.json, pero TypeScript no agrega la extensión a los destinos
		// de `imports` (`#lib/state/session` → `session.ts`). Kit 3 tampoco lo
		// traduce a `paths` en su tsconfig base, así que se declara acá.
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	// Kit 3 ya no genera .svelte-kit/tsconfig.json (el config base vive en
	// node_modules/$app/tsconfig.json y no trae include/exclude): se listan
	// acá los mismos que traía el generado por Kit 2.
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/env.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte"
	],
	"exclude": ["node_modules/**", "src/service-worker.ts", "src/service-worker/**"]
	// Path aliases are handled by https://svelte.dev/docs/kit/configuration#alias
	// `#lib` sale del campo `imports` de package.json (subpath imports, #130)
	//
	// To make changes to top-level options such as include and exclude, we recommend extending
	// the generated config; see https://svelte.dev/docs/kit/configuration#typescript
}
