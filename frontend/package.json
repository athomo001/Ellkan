{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "cd ../app-escritorio/src-tauri && node ../../frontend/node_modules/@tauri-apps/cli/tauri.js",
		"build:desktop": "node ../app-escritorio/scripts/compilar.mjs",
		"test:a11y": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.12.5",
		"@types/qrcode": "^1.5.6",
		"@types/zxcvbn": "^4.4.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"kdbxweb": "^2.1.1",
		"qrcode": "^1.5.4",
		"zxcvbn": "^4.4.2"
	}
}
