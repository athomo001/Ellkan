  "query": "select u.email, u.display_name, r.name as role, u.created_at, u.updated_at,\n                      uk.created_at as keys_created_at\n               from users u\n               join roles r on r.id = u.role_id\n               join user_keys uk on uk.user_id = u.id\n               where u.id = $1",
