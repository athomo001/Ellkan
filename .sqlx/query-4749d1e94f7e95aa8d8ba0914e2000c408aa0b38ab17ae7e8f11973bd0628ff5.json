  "query": "\n            select uk.encrypted_private_key_blob, uk.private_key_nonce, uk.kdf_salt\n            from user_keys uk\n            join users u on u.id = uk.user_id\n            where u.email = $1 and u.active and u.deleted_at is null and u.email_verified_at is not null\n            ",
