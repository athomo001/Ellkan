  "query": "\n            insert into users (email, display_name, role_id)\n            values ($1, $2, (\n                select id from roles where name =\n                    case when exists (select 1 from users) then 'user' else 'admin' end\n            ))\n            returning id, security_stamp, created_at\n            ",
