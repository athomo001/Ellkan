{
	"name": "ellkan-extension",
	"private": true,
	"version": "0.2.2",
	"type": "module",
	"bin": {
		"ellkan-ext": "cli.mjs"
	},
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build",
		"build:chrome": "cross-env BROWSER=chrome vite build",
		"build:firefox": "cross-env BROWSER=firefox vite build",
		"build:safari": "cross-env BROWSER=safari vite build",
		"check": "tsc --noEmit",
		"check:self": "node run-self-check.mjs",
		"package": "node cli.mjs",
		"version:set": "node version.mjs --set"
	},
	"dependencies": {
		"tldts": "^7.4.12",
		"zxcvbn": "^4.4.2"
	},
	"devDependencies": {
		"@types/chrome": "^0.1.15",
		"@types/zxcvbn": "^4.4.5",
		"cross-env": "^10.1.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.0"
	}
}
