# Copiar a `.env` (gitignored) y ajustar valores. No poner secretos acá —
# esos van en ./secrets/ vía convención *_FILE (ver docker-compose.yml).
ELLKAN_PORT=8080
POSTGRES_DB=ellkan
POSTGRES_USER=ellkan
POSTGRES_IMAGE=postgres:18
# Puerto de Postgres expuesto en 127.0.0.1 — para `ellkan-cli admin ...` desde
# el host (ver manual/cli.md). Nunca 0.0.0.0: Postgres no debe quedar accesible
# desde fuera de esta máquina.
POSTGRES_PORT=5433
