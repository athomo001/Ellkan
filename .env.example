# Copiar a `.env` (gitignored) y ajustar valores. No poner secretos acá —
# esos van en ./secrets/ vía convención *_FILE (ver docker-compose.yml).
ELLKAN_PORT=8080
# Versión del servidor (imagen ghcr.io/athomo001/ellkan). `latest` es la última
# publicada; en producción conviene fijar una (por ejemplo 0.2.0) y cambiarla a
# propósito al actualizar. Las versiones están en la página de Releases.
# `dev` es la de la rama de desarrollo: sólo para probar, no para producción.
ELLKAN_VERSION=latest
# Dirección con la que se entra a Ellkan (passkeys y links de los emails).
# Sin definirlas, docker-compose usa localhost y el puerto de ELLKAN_PORT (sirve
# para esta máquina). En un servidor, descomentalas con tu dominio:
# ELLKAN_RP_ID=ellkan.tuempresa.com
# ELLKAN_RP_ORIGIN=https://ellkan.tuempresa.com
# Con un reverse proxy delante (Caddy, nginx, Traefik): su IP o rango, para
# que los límites por IP vean al cliente real. Ver manual/instalacion.md.
# ELLKAN_TRUSTED_PROXIES=172.16.0.0/12
POSTGRES_DB=ellkan
POSTGRES_USER=ellkan
POSTGRES_IMAGE=postgres:18
# Puerto de Postgres expuesto en 127.0.0.1 — para `ellkan-cli admin ...` desde
# el host (ver manual/cli.md). Nunca 0.0.0.0: Postgres no debe quedar accesible
# desde fuera de esta máquina.
POSTGRES_PORT=5433
