{
  "$schema": "../../frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ellkan",
  "version": "0.1.0",
  "identifier": "com.ellkan.desktop",
  "build": {
    "frontendDist": "../../frontend/build",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../frontend" }
  },
  "app": {
    "windows": [
      {
        "title": "Ellkan",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
