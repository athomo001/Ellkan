  "query": "\n            select id, user_id, device_public_key, fingerprint, status,\n                   sealed_user_private_key, session_id, expires_at\n            from device_approval_requests\n            where user_id = $1 and status = 'pending' and expires_at > now()\n            order by created_at\n            ",
