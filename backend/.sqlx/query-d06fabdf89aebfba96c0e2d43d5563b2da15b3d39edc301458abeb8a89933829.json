  "query": "\n            select id as resource_id, created_by, created_at\n            from resources\n            where deleted_at is null\n              and updated_at = created_at\n              and created_at < now() - make_interval(days => $1::int)\n              and ($2::uuid is null or id < $2)\n            order by id desc\n            limit $3\n            ",
